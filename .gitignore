# Auto-generated API command modules. Built on first run by
# te_api.builder.ensure_api_built (or manually via `te-api build`)
# from the user's own OpenAPI schema.
te_api/api/*.py
!te_api/api/__init__.py
te_api/api_ro/*.py
!te_api/api_ro/__init__.py

# OpenAPI spec snapshot. Each user downloads their own; we don't ship one.
transparent-api.yaml
